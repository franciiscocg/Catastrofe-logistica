generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  CIUDADANO
  VOLUNTARIO
  PUESTO_EMERGENCIA
  COORDINADOR
}

enum FaseCatastrofe {
  RESCATE
  LIMPIEZA
  RECONSTRUCCION
}

enum TipoInventario {
  DISPONIBLE
  NECESARIO
}

enum EstadoVia {
  CORTADA
  TRANSITABLE
}

enum EstadoDonacion {
  PENDIENTE
  EN_CAMINO
  ENTREGADA
  CANCELADA
}

enum EstadoAsignacionPuesto {
  ACTIVA
  FINALIZADA
  CANCELADA
}

enum EstadoPuesto {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoAsignacionIncidencia {
  ACTIVA
  FINALIZADA
  CANCELADA
}

enum EstadoSolicitudPuesto {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum EstadoSolicitudParticipacionPuesto {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

model Usuario {
  id        String       @id @default(cuid())
  email     String       @unique
  password  String
  nombre    String
  apellidos String
  telefono  String?
  dni       String?      @unique
  roles     RolUsuario[]
  activo    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  voluntario         Voluntario?
  puestosAdmin       PuestoEmergencia[]  @relation("AdminPuesto")
  puestosTrabajador  PuestoTrabajador[]  @relation("TrabajadoresPuesto")
  auditLogs          AuditLog[]
  incidenciasReportadas IncidenciaVia[] @relation("ReportanteIncidencia")
  comentariosIncidencias ComentarioIncidenciaVia[] @relation("AutorComentarioIncidencia")
  solicitudesPuesto  SolicitudPuesto[] @relation("SolicitantePuesto")
  solicitudesPuestoRevisadas SolicitudPuesto[] @relation("CoordinadorSolicitudPuesto")
  solicitudesParticipacionPuesto SolicitudParticipacionPuesto[] @relation("SolicitanteParticipacionPuesto")
  solicitudesParticipacionPuestoRevisadas SolicitudParticipacionPuesto[] @relation("ResponsableParticipacionPuesto")

  @@map("usuarios")
}

model Catastrofe {
  id          String         @id @default(cuid())
  nombre      String
  descripcion String
  tipo        String
  latitud     Float
  longitud    Float
  radio       Float
  activa      Boolean        @default(true)
  fase        FaseCatastrofe @default(RESCATE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  puestos PuestoEmergencia[]
  incidencias IncidenciaVia[]

  @@map("catastrofes")
}

model IncidenciaVia {
  id           String    @id @default(cuid())
  catastrofeId String
  reportanteId String?
  latitud      Float
  longitud     Float
  estado       EstadoVia
  descripcion  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  catastrofe Catastrofe @relation(fields: [catastrofeId], references: [id])
  reportante Usuario?   @relation("ReportanteIncidencia", fields: [reportanteId], references: [id])
  comentarios ComentarioIncidenciaVia[]
  asignacionesVoluntarios AsignacionIncidencia[]

  @@index([catastrofeId, createdAt])
  @@index([estado])
  @@map("incidencias_via")
}

model ComentarioIncidenciaVia {
  id           String    @id @default(cuid())
  incidenciaId String
  autorId      String?
  estado       EstadoVia
  comentario   String
  createdAt    DateTime  @default(now())

  incidencia IncidenciaVia @relation(fields: [incidenciaId], references: [id])
  autor      Usuario?      @relation("AutorComentarioIncidencia", fields: [autorId], references: [id])

  @@index([incidenciaId, createdAt])
  @@map("comentarios_incidencias_via")
}

model PuestoEmergencia {
  id           String     @id @default(cuid())
  nombre       String
  descripcion  String?
  direccion    String
  latitud      Float
  longitud     Float
  tipo         String
  activo          Boolean      @default(true)
  estadoSolicitud EstadoPuesto @default(PENDIENTE)
  motivoRechazo   String?
  capacidadTrabajo Int         @default(6)
  catastrofeId String
  adminId      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  catastrofe   Catastrofe       @relation(fields: [catastrofeId], references: [id])
  admin        Usuario          @relation("AdminPuesto", fields: [adminId], references: [id])
  inventario   Inventario[]
  donaciones   Donacion[]
  asignacionesVoluntarios AsignacionPuesto[]
  trabajadores PuestoTrabajador[]
  solicitudesParticipacion SolicitudParticipacionPuesto[]

  @@map("puestos_emergencia")
}

model SolicitudParticipacionPuesto {
  id             String                              @id @default(cuid())
  puestoId       String
  usuarioId      String
  responsableId  String?
  estado         EstadoSolicitudParticipacionPuesto  @default(PENDIENTE)
  motivoRechazo  String?
  decidedAt      DateTime?
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt

  puesto      PuestoEmergencia @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  usuario     Usuario          @relation("SolicitanteParticipacionPuesto", fields: [usuarioId], references: [id])
  responsable Usuario?         @relation("ResponsableParticipacionPuesto", fields: [responsableId], references: [id])

  @@index([puestoId, estado, createdAt])
  @@index([usuarioId, estado])
  @@map("solicitudes_participacion_puesto")
}

model PuestoTrabajador {
  id        String   @id @default(cuid())
  puestoId  String
  usuarioId String
  addedBy   String
  addedAt   DateTime @default(now())

  puesto  PuestoEmergencia @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  usuario Usuario          @relation("TrabajadoresPuesto", fields: [usuarioId], references: [id])

  @@unique([puestoId, usuarioId])
  @@map("puesto_trabajadores")
}

model SolicitudPuesto {
  id             String                @id @default(cuid())
  usuarioId      String
  coordinadorId  String?
  nombre         String
  descripcion    String?
  direccion      String
  latitud        Float
  longitud       Float
  tipo           String
  estado         EstadoSolicitudPuesto @default(PENDIENTE)
  motivoRechazo  String?
  decidedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  usuario     Usuario  @relation("SolicitantePuesto", fields: [usuarioId], references: [id])
  coordinador Usuario? @relation("CoordinadorSolicitudPuesto", fields: [coordinadorId], references: [id])

  @@index([estado, createdAt])
  @@index([usuarioId, estado])
  @@map("solicitudes_puesto")
}

model Producto {
  id        String   @id @default(cuid())
  nombre    String
  categoria String
  unidad    String
  createdAt DateTime @default(now())

  inventarios Inventario[]
  donaciones Donacion[]

  @@map("productos")
}

model Inventario {
  id         String           @id @default(cuid())
  puestoId   String
  productoId String
  cantidad   Float
  tipo       TipoInventario
  updatedAt  DateTime         @updatedAt

  puesto   PuestoEmergencia @relation(fields: [puestoId], references: [id])
  producto Producto         @relation(fields: [productoId], references: [id])

  @@unique([puestoId, productoId, tipo])
  @@map("inventario")
}

model Voluntario {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  modalidad String?
  vehiculo  Json?
  verificado Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  donaciones Donacion[]
  asignacionesPuestos AsignacionPuesto[]
  asignacionesIncidencias AsignacionIncidencia[]

  @@map("voluntarios")
}

model AsignacionPuesto {
  id           String                 @id @default(cuid())
  voluntarioId String
  puestoId     String
  estado       EstadoAsignacionPuesto @default(ACTIVA)
  startedAt    DateTime               @default(now())
  endedAt      DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  voluntario Voluntario       @relation(fields: [voluntarioId], references: [id])
  puesto     PuestoEmergencia @relation(fields: [puestoId], references: [id])

  @@index([voluntarioId, estado])
  @@index([puestoId, estado])
  @@map("asignaciones_puestos")
}

model AsignacionIncidencia {
  id           String                    @id @default(cuid())
  voluntarioId String
  incidenciaId String
  estado       EstadoAsignacionIncidencia @default(ACTIVA)
  startedAt    DateTime                  @default(now())
  endedAt      DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  voluntario Voluntario   @relation(fields: [voluntarioId], references: [id])
  incidencia IncidenciaVia @relation(fields: [incidenciaId], references: [id])

  @@index([voluntarioId, estado])
  @@index([incidenciaId, estado])
  @@map("asignaciones_incidencias")
}

model Donacion {
  id           String         @id @default(cuid())
  voluntarioId String
  puestoId     String
  productoId   String
  cantidad     Float
  unidad       String
  estado       EstadoDonacion @default(PENDIENTE)
  comentario   String?
  eta          DateTime?
  entregaCodigo String?       @unique
  entregaCodigoGeneradoAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  voluntario Voluntario        @relation(fields: [voluntarioId], references: [id])
  puesto     PuestoEmergencia  @relation(fields: [puestoId], references: [id])
  producto   Producto          @relation(fields: [productoId], references: [id])

  @@index([voluntarioId, estado])
  @@index([puestoId, estado])
  @@index([productoId])
  @@map("donaciones")
}

model AuditLog {
  id        String   @id @default(cuid())
  usuarioId String?
  accion    String
  entidad   String
  entidadId String
  datos     Json?
  ip        String?
  createdAt DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@map("audit_logs")
}
