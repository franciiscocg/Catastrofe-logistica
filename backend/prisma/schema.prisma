generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  CIUDADANO
  VOLUNTARIO
  PUESTO_EMERGENCIA
  COORDINADOR
}

enum FaseCatastrofe {
  RESCATE
  LIMPIEZA
  RECONSTRUCCION
}

enum TipoInventario {
  DISPONIBLE
  NECESARIO
}

enum EstadoVia {
  CORTADA
  TRANSITABLE
}

enum EstadoDonacion {
  PENDIENTE
  EN_CAMINO
  ENTREGADA
  CANCELADA
}

enum EstadoAsignacionPuesto {
  ACTIVA
  FINALIZADA
  CANCELADA
}

model Usuario {
  id        String       @id @default(cuid())
  email     String       @unique
  password  String
  nombre    String
  apellidos String
  telefono  String?
  dni       String?      @unique
  roles     RolUsuario[]
  activo    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  voluntario  Voluntario?
  puestosAdmin PuestoEmergencia[] @relation("AdminPuesto")
  auditLogs   AuditLog[]
  incidenciasReportadas IncidenciaVia[] @relation("ReportanteIncidencia")
  comentariosIncidencias ComentarioIncidenciaVia[] @relation("AutorComentarioIncidencia")

  @@map("usuarios")
}

model Catastrofe {
  id          String         @id @default(cuid())
  nombre      String
  descripcion String
  tipo        String
  latitud     Float
  longitud    Float
  radio       Float
  activa      Boolean        @default(true)
  fase        FaseCatastrofe @default(RESCATE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  puestos PuestoEmergencia[]
  incidencias IncidenciaVia[]

  @@map("catastrofes")
}

model IncidenciaVia {
  id           String    @id @default(cuid())
  catastrofeId String
  reportanteId String?
  latitud      Float
  longitud     Float
  estado       EstadoVia
  descripcion  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  catastrofe Catastrofe @relation(fields: [catastrofeId], references: [id])
  reportante Usuario?   @relation("ReportanteIncidencia", fields: [reportanteId], references: [id])
  comentarios ComentarioIncidenciaVia[]

  @@index([catastrofeId, createdAt])
  @@index([estado])
  @@map("incidencias_via")
}

model ComentarioIncidenciaVia {
  id           String    @id @default(cuid())
  incidenciaId String
  autorId      String?
  estado       EstadoVia
  comentario   String
  createdAt    DateTime  @default(now())

  incidencia IncidenciaVia @relation(fields: [incidenciaId], references: [id])
  autor      Usuario?      @relation("AutorComentarioIncidencia", fields: [autorId], references: [id])

  @@index([incidenciaId, createdAt])
  @@map("comentarios_incidencias_via")
}

model PuestoEmergencia {
  id           String     @id @default(cuid())
  nombre       String
  descripcion  String?
  direccion    String
  latitud      Float
  longitud     Float
  tipo         String
  activo       Boolean    @default(true)
  capacidadTrabajo Int     @default(6)
  catastrofeId String
  adminId      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  catastrofe Catastrofe @relation(fields: [catastrofeId], references: [id])
  admin      Usuario    @relation("AdminPuesto", fields: [adminId], references: [id])
  inventario Inventario[]
  donaciones Donacion[]
  asignacionesVoluntarios AsignacionPuesto[]

  @@map("puestos_emergencia")
}

model Producto {
  id        String   @id @default(cuid())
  nombre    String
  categoria String
  unidad    String
  createdAt DateTime @default(now())

  inventarios Inventario[]
  donaciones Donacion[]

  @@map("productos")
}

model Inventario {
  id         String           @id @default(cuid())
  puestoId   String
  productoId String
  cantidad   Float
  tipo       TipoInventario
  updatedAt  DateTime         @updatedAt

  puesto   PuestoEmergencia @relation(fields: [puestoId], references: [id])
  producto Producto         @relation(fields: [productoId], references: [id])

  @@unique([puestoId, productoId, tipo])
  @@map("inventario")
}

model Voluntario {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  modalidad String?
  vehiculo  Json?
  verificado Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  donaciones Donacion[]
  asignacionesPuestos AsignacionPuesto[]

  @@map("voluntarios")
}

model AsignacionPuesto {
  id           String                 @id @default(cuid())
  voluntarioId String
  puestoId     String
  estado       EstadoAsignacionPuesto @default(ACTIVA)
  startedAt    DateTime               @default(now())
  endedAt      DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  voluntario Voluntario       @relation(fields: [voluntarioId], references: [id])
  puesto     PuestoEmergencia @relation(fields: [puestoId], references: [id])

  @@index([voluntarioId, estado])
  @@index([puestoId, estado])
  @@map("asignaciones_puestos")
}

model Donacion {
  id           String         @id @default(cuid())
  voluntarioId String
  puestoId     String
  productoId   String
  cantidad     Float
  unidad       String
  estado       EstadoDonacion @default(PENDIENTE)
  comentario   String?
  eta          DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  voluntario Voluntario        @relation(fields: [voluntarioId], references: [id])
  puesto     PuestoEmergencia  @relation(fields: [puestoId], references: [id])
  producto   Producto          @relation(fields: [productoId], references: [id])

  @@index([voluntarioId, estado])
  @@index([puestoId, estado])
  @@index([productoId])
  @@map("donaciones")
}

model AuditLog {
  id        String   @id @default(cuid())
  usuarioId String?
  accion    String
  entidad   String
  entidadId String
  datos     Json?
  ip        String?
  createdAt DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@map("audit_logs")
}
